# VLoggo reads these process.env values only when notify is enabled or omitted.
# Set notify: false to skip SMTP entirely and suppress configuration diagnostics.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=logs@myapp.com
SMTP_TO=admin@myapp.com
