{
  "name": "vloggo",
  "version": "2.0.0",
  "private": false,
  "description": "Logging library for Node.js and Bun with file rotation, SMTP notifications, and JSON output support.",
  "homepage": "https://github.com/vinialx/vloggo#readme",
  "bugs": {
    "url": "https://github.com/vinialx/vloggo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinialx/vloggo.git"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "license": "ISC",
  "author": "vinialx",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('build', { recursive: true, force: true });\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit && tsc -p tests/types/tsconfig.json",
    "test": "bun run build && node --test tests/*.test.mjs",
    "test:bun": "bun run build && bun run tests/bun-smoke.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "bun run typecheck && bun run test && bun run test:package",
    "preversion": "bun run typecheck && bun run test"
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "nodemailer",
    "file-logging",
    "email-notifications"
  ]
}
